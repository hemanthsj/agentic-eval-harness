# Which LLM provider the harness uses.
# "mock" runs fully offline and deterministically (no API key required).
# "anthropic" uses the real Anthropic API (requires ANTHROPIC_API_KEY).
EVAL_PROVIDER=mock  # or "anthropic"

# Anthropic API key (only needed when EVAL_PROVIDER=anthropic).
ANTHROPIC_API_KEY=

# Model used by the real Anthropic judge.
EVAL_JUDGE_MODEL=claude-sonnet-5
